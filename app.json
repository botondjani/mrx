{
  "expo": {
    "name": "Mr. X",
    "slug": "mrx",
    "scheme": "mrx",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.botondjani.mrx"
    },
    "android": {
      "package": "com.botondjani.mrx",
      "adaptiveIcon": {
        "backgroundColor": "#0e0f13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "A játék a háttérben is követi a helyzetedet, hogy a többiek lássanak.",
          "locationWhenInUsePermission": "A játékhoz szükség van a helyzetedre."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e0f13",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "37816be3-0f65-4a39-a9f9-c2964432dff2"
      }
    },
    "owner": "botond2004s-team",
    "updates": {
      "url": "https://u.expo.dev/37816be3-0f65-4a39-a9f9-c2964432dff2"
    }
  }
}
